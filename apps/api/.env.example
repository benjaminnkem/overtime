DATABASE_URL="postgresql://postgres:postgres@localhost:5432/overtime?schema=public"

# Custodial wallet that receives pooled entry fees and (eventually) sends payouts.
# A 32-byte hex-encoded private key — NOT a BIP39 mnemonic. The nimiq.dev docs site
# currently shows a MnemonicUtils/ExtendedPrivateKey API for deriving this from a
# seed phrase, but that API doesn't exist in @nimiq/core@2.21.0 (checked the actual
# shipped .d.ts files). Generate a throwaway one for local dev with:
#   node -e "console.log(require('@nimiq/core').PrivateKey.generate().toHex())"
# The value below is one such throwaway key — it holds no funds, replace it for
# anything beyond wiring tests, and never reuse a key that has ever held real NIM.
NIMIQ_CUSTODIAL_PRIVATE_KEY=1ae155f82dc2df9071249e3b753427a35c1c7980a573ba6b071669ef15a41f61

# Which Nimiq network the client connects to for deposit verification and payouts.
# Defaults to TestAlbatross (testnet) if unset. Only set to MainAlbatross once
# real payouts are actually intended — see the known connectivity issue noted
# in docs/ARCHITECTURE.md before relying on this for anything live.
NIMIQ_NETWORK=TestAlbatross

PORT=4000
